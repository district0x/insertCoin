generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = "5"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String       @id @default(uuid())
  address           String?      @unique
  discordId         String?      @unique
  username          String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  totalMatches      Int          @default(0)
  totalWins         Int          @default(0)
  totalLosses       Int          @default(0)
  matchesCreated    Match[]      @relation("Creator")
  TeamMember        TeamMember[]
  Match_Participant Match[]      @relation("Participant")
  Tournament        Tournament[] @relation("TournamentParticipant")
}

model Match {
  id               String      @id @default(uuid())
  matchId          Int         @unique
  matchType        MatchType
  status           MatchStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  creatorId        String?
  creatorDiscordId String?
  stake            Float
  tokenAddress     String?
  totalPrize       Float
  winnerAddress    String?
  discordChannelId String?
  creator          User?       @relation("Creator", fields: [creatorId], references: [id])
  teams            Team[]
  User_Participant User[]      @relation("Participant")

  @@index([matchId])
  @@index([creatorDiscordId])
  @@index([discordChannelId])
}

model Tournament {
  id              String           @id @default(uuid())
  tournamentId    Int              @unique
  status          TournamentStatus
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  entryFee        Float
  tokenAddress    String?
  totalPrize      Float
  maxParticipants Int
  User            User[]           @relation("TournamentParticipant")

  @@index([tournamentId])
}

model Team {
  id         String       @id @default(uuid())
  matchId    String
  isTeamA    Boolean
  match      Match        @relation(fields: [matchId], references: [id])
  TeamMember TeamMember[]

  @@unique([matchId, isTeamA])
}

model TeamMember {
  id     String @id
  teamId String
  userId String
  Team   Team   @relation(fields: [teamId], references: [id])
  User   User   @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

enum MatchType {
  ONE_V_ONE
  TWO_V_TWO
  FIVE_V_FIVE
}

enum MatchStatus {
  PENDING
  OPEN
  FILLED
  COMPLETED
  CANCELLED
}

enum TournamentStatus {
  CREATED
  FILLING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
