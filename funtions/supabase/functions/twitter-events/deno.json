{
  "tasks": {
    "start": "deno run --allow-net --allow-env index.ts",
    "dev": "supabase functions serve twitter-events --env-file supabase/.env",
    "deploy": "supabase functions deploy twitter-events"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom"],
    "allowJs": true,
    "strict": false
  },
  "fmt": {
    "options": {
      "lineWidth": 100,
      "indentWidth": 2,
      "singleQuote": false
    }
  }
} 