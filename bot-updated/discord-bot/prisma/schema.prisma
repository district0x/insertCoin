generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = "5"
  interface            = "sync"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                  @id @default(uuid())
  address               String?                 @unique
  discordId             String?                 @unique
  username              String?                 @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  totalMatches          Int                     @default(0)
  totalWins             Int                     @default(0)
  totalLosses           Int                     @default(0)
  matchesCreated        Match[]                 @relation("Creator")
  Participant           Participant[]
  TeamMember            TeamMember[]
  TournamentParticipant TournamentParticipant[]
}

model Match {
  id               String        @id @default(uuid())
  matchId          Int           @unique
  matchType        MatchType
  status           MatchStatus   @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  creatorId        String?
  creatorDiscordId String?
  stake            Float
  tokenAddress     String?
  totalPrize       Float
  winnerAddress    String?
  creator          User?         @relation("Creator", fields: [creatorId], references: [id])
  teams            Team[]
  Participant      Participant[]

  @@index([matchId])
  @@index([creatorDiscordId])
}

model Tournament {
  id                    String                  @id @default(uuid())
  tournamentId          Int                     @unique
  status                TournamentStatus
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  entryFee              Float
  tokenAddress          String?
  totalPrize            Float
  maxParticipants       Int
  TournamentParticipant TournamentParticipant[]

  @@index([tournamentId])
}

model Team {
  id         String       @id @default(uuid())
  matchId    String
  isTeamA    Boolean
  match      Match        @relation(fields: [matchId], references: [id])
  TeamMember TeamMember[]

  @@unique([matchId, isTeamA])
}

model Participant {
  A     String
  B     String
  Match Match  @relation(fields: [A], references: [id], onDelete: Cascade)
  User  User   @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_Participant_AB_pkey")
  @@index([B], map: "_Participant_B_index")
  @@map("_Participant")
}

model TeamMember {
  A    String
  B    String
  Team Team   @relation(fields: [A], references: [id], onDelete: Cascade)
  User User   @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_TeamMember_AB_pkey")
  @@index([B], map: "_TeamMember_B_index")
  @@map("_TeamMember")
}

model TournamentParticipant {
  A          String
  B          String
  Tournament Tournament @relation(fields: [A], references: [id], onDelete: Cascade)
  User       User       @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_TournamentParticipant_AB_pkey")
  @@index([B], map: "_TournamentParticipant_B_index")
  @@map("_TournamentParticipant")
}

enum MatchType {
  ONE_V_ONE
  TWO_V_TWO
  FIVE_V_FIVE
}

enum MatchStatus {
  PENDING
  OPEN
  FILLED
  COMPLETED
  CANCELLED
}

enum TournamentStatus {
  CREATED
  FILLING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
