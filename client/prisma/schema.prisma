generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(uuid())
  address            String?  @unique
  discordId          String?  @unique
  username           String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  totalMatches       Int      @default(0)
  totalWins          Int      @default(0)
  totalLosses        Int      @default(0)
  matchTokensEarned  Float    @default(0) // Total MATCH tokens earned
  ethEarned          Float    @default(0) // Total ETH earned
  isBanned           Boolean  @default(false)
  banReason          String?
  banExpiry          DateTime?
  createdMatches     Match[]  @relation("Creator")
}

model BanRecord {
  id          String    @id @default(uuid())
  userId      String    // Discord ID
  reason      String
  bannedBy    String    // Admin Discord ID
  bannedAt    DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  
  @@index([userId])
  @@index([isActive])
}

model Match {
  id                String      @id @default(uuid())
  matchId           Int?        @unique
  matchType         MatchType
  status            MatchStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  creatorId         String?
  creatorDiscordId  String?
  creatorAddress    String?
  creatorName       String?     // Username of match creator
  stake             Float
  tokenName         String?
  totalPrize        Float
  winnerAddress     String?
  discordChannelId  String?
  game              String?
  gameCategory      String?
  matchAmountUsd    Int?
  player2DiscordId  String?
  player2Address    String?
  player2Name       String?     // Username of player2
  platform          String?
  winnerId          String?
  roomId            String?     @unique
  creator           User?       @relation("Creator", fields: [creatorId], references: [id])

  @@index([matchId])
  @@index([roomId])
  @@index([creatorDiscordId])
  @@index([discordChannelId])
  @@index([player2DiscordId])
  @@index([winnerId])
  @@index([creatorAddress])
  @@index([player2Address])
}

model Tournament {
  id              String           @id @default(uuid())
  tournamentId    Int              @unique
  status          TournamentStatus
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  entryFee        Float
  tokenAddress    String?
  totalPrize      Float
  maxParticipants Int

  @@index([tournamentId])
}

model Team {
  id      String  @id @default(uuid())
  matchId String
  isTeamA Boolean

  @@unique([matchId, isTeamA])
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String
  userId String

  @@unique([teamId, userId])
}

model VerificationTransaction {
  id            String             @id
  txHash        String             @unique
  discordId     String
  walletAddress String
  amount        String
  status        VerificationStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  verifiedAt    DateTime?

  @@index([discordId])
  @@index([status])
  @@index([txHash])
  @@index([walletAddress])
}

model Participant {
  A String
  B String

  @@unique([A, B], map: "_Participant_AB_unique")
  @@index([B], map: "_Participant_B_index")
  @@map("_Participant")
}

model TournamentParticipant {
  A String
  B String

  @@id([A, B], map: "_TournamentParticipant_AB_pkey")
  @@index([B], map: "_TournamentParticipant_B_index")
  @@map("_TournamentParticipant")
}

enum MatchType {
  ONE_V_ONE
  TWO_V_TWO
  FIVE_V_FIVE
}

enum MatchStatus {
  PENDING
  OPEN
  FILLED
  COMPLETED
  CANCELLED
}

enum TournamentStatus {
  CREATED
  FILLING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

model PlayerMatchup {
  id            String   @id @default(uuid())
  player1Id     String   // Discord ID
  player2Id     String   // Discord ID
  player1Wins   Int      @default(0)
  player2Wins   Int      @default(0)
  totalMatches  Int      @default(0)
  lastMatchDate DateTime @updatedAt
  createdAt     DateTime @default(now())
  
  @@unique([player1Id, player2Id])
  @@index([player1Id])
  @@index([player2Id])
}

model PlayerTeamStats {
  id            String   @id @default(uuid())
  playerId      String   // Discord ID
  matchType     String   // "1v1", "2v2", "5v5"
  totalMatches  Int      @default(0)
  totalWins     Int      @default(0)
  totalLosses   Int      @default(0)
  teamWins      Int      @default(0)  // Wins in team matches
  teamLosses    Int      @default(0)  // Losses in team matches
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([playerId, matchType])
  @@index([playerId])
  @@index([matchType])
}

model TeamMatchup {
  id            String   @id @default(uuid())
  matchId       String   // Reference to the match
  team1Players  String[] // Array of Discord IDs
  team2Players  String[] // Array of Discord IDs
  winnerTeam    Int      // 1 or 2
  matchType     String   // "2v2" or "5v5"
  createdAt     DateTime @default(now())
  
  @@index([matchId])
  @@index([team1Players])
  @@index([team2Players])
}
