generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(uuid())
  address          String?  @unique
  discordId        String?  @unique
  username         String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  totalMatches     Int      @default(0)
  totalWins        Int      @default(0)
  totalLosses      Int      @default(0)
  matchTokensEarned Float   @default(0) // Track MATCH tokens earned
  createdMatches   Match[]  @relation("Creator")
}

model Match {
  id                String      @id @default(uuid())
  matchId           Int?        @unique
  matchType         MatchType
  status            MatchStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  creatorId         String?
  creatorDiscordId  String?
  creatorAddress    String?
  stake             Float
  tokenAddress      String?
  totalPrize        Float
  winnerAddress     String?
  discordChannelId  String?
  game              String?
  gameCategory      String?
  matchAmountUsd    Int?
  opponentDiscordId String?
  player2Address    String?
  platform          String?
  winnerId          String?
  roomId            String?     @unique
  creator           User?       @relation("Creator", fields: [creatorId], references: [id])

  @@index([matchId])
  @@index([roomId])
  @@index([creatorDiscordId])
  @@index([discordChannelId])
  @@index([opponentDiscordId])
  @@index([winnerId])
  @@index([creatorAddress])
  @@index([player2Address])
}

model Tournament {
  id              String           @id @default(uuid())
  tournamentId    Int              @unique
  status          TournamentStatus
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  entryFee        Float
  tokenAddress    String?
  totalPrize      Float
  maxParticipants Int

  @@index([tournamentId])
}

model Team {
  id      String  @id @default(uuid())
  matchId String
  isTeamA Boolean

  @@unique([matchId, isTeamA])
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String
  userId String

  @@unique([teamId, userId])
}

model VerificationTransaction {
  id            String             @id
  txHash        String             @unique
  discordId     String
  walletAddress String
  amount        String
  status        VerificationStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  verifiedAt    DateTime?

  @@index([discordId])
  @@index([status])
  @@index([txHash])
  @@index([walletAddress])
}

model Participant {
  A String
  B String

  @@unique([A, B], map: "_Participant_AB_unique")
  @@index([B], map: "_Participant_B_index")
  @@map("_Participant")
}

model TournamentParticipant {
  A String
  B String

  @@id([A, B], map: "_TournamentParticipant_AB_pkey")
  @@index([B], map: "_TournamentParticipant_B_index")
  @@map("_TournamentParticipant")
}

enum MatchType {
  ONE_V_ONE
  TWO_V_TWO
  FIVE_V_FIVE
}

enum MatchStatus {
  PENDING
  OPEN
  FILLED
  COMPLETED
  CANCELLED
}

enum TournamentStatus {
  CREATED
  FILLING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}
