generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model
model User {
  id            String    @id @default(uuid())
  address       String?   @unique // Ethereum address
  discordId     String?   @unique // Discord user ID
  username      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Stats and profile
  totalMatches  Int       @default(0)
  totalWins     Int       @default(0)
  totalLosses   Int       @default(0)
  
  // Relations
  matchesCreated    Match[]    @relation("Creator")
  participatedMatches Match[]  @relation("Participant")
  tournamentsJoined Tournament[] @relation("TournamentParticipant")
  teamMemberships   TeamMember[]
}

// Match model
model Match {
  id               String        @id @default(uuid())
  matchId          Int           @unique
  matchType        MatchType
  status           MatchStatus   @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  // Creator details
  creatorId        String?
  creator          User?         @relation("Creator", fields: [creatorId], references: [id])
  creatorDiscordId String?
  
  // Match details
  stake            Float
  tokenAddress     String?       // null for ETH
  totalPrize       Float
  winnerAddress    String?
  discordChannelId String?       // Discord channel ID for match notifications
  
  // Relations
  teams            Team[]
  participants     User[]        @relation("Participant")
  
  @@index([matchId])
  @@index([creatorDiscordId])
  @@index([discordChannelId])
}

// Tournament model
model Tournament {
  id              String    @id @default(uuid())
  tournamentId    Int       @unique
  status          TournamentStatus
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  entryFee       Float
  tokenAddress   String?
  totalPrize     Float
  maxParticipants Int
  
  participants    User[]    @relation("TournamentParticipant")
  
  @@index([tournamentId])
}

// Team model
model Team {
  id            String        @id @default(uuid())
  matchId       String
  match         Match         @relation(fields: [matchId], references: [id])
  isTeamA       Boolean
  members       TeamMember[]
  
  @@unique([matchId, isTeamA])
}

// TeamMember model for many-to-many relation between Team and User
model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  team      Team     @relation(fields: [teamId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  
  @@unique([teamId, userId])
}

enum MatchType {
  ONE_V_ONE
  TWO_V_TWO
  FIVE_V_FIVE
}

enum MatchStatus {
  PENDING     // Created by Discord bot, waiting for on-chain creation
  OPEN        // Created on-chain, waiting for players
  FILLED      // All players joined
  COMPLETED   // Match finished
  CANCELLED   // Match cancelled
}

enum TournamentStatus {
  CREATED
  FILLING
  IN_PROGRESS
  COMPLETED
  CANCELLED
} 